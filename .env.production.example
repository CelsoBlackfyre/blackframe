APP_NAME=BlackFrame
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8080
APP_TRUSTED_HOSTS=127.0.0.1,localhost
# Safe only because compose.production.yaml does not publish the web container.
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=blackframe
DB_USERNAME=blackframe
DB_PASSWORD=
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Change to true only after the public HTTPS domain is active.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=blackframe_cache

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=BlackFrame

TMDB_API_TOKEN=
CATALOG_API_TIMEOUT=4

HEALTHCHECK_HOST=127.0.0.1
CADDY_SITE_ADDRESS=http://
BLACKFRAME_HTTP_BIND=127.0.0.1:8080
BLACKFRAME_HTTPS_BIND=127.0.0.1:8443
BLACKFRAME_DATA_ROOT=/srv/blackframe-data
BLACKFRAME_ENV_FILE=/srv/blackframe-data/config/app.env
BLACKFRAME_IMAGE_TAG=production
