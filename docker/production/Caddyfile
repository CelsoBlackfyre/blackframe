{
    admin off

    servers {
        trusted_proxies static private_ranges
    }
}

{$CADDY_SITE_ADDRESS:http://} {
    encode zstd gzip

    header {
        -Server
    }

    route {
        @reverb path /app/*
        reverse_proxy @reverb reverb:8080
        reverse_proxy blackframe-web:80
    }
}
