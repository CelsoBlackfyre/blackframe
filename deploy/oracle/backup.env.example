BLACKFRAME_PROJECT_DIR=/opt/blackframe
BLACKFRAME_DATA_ROOT=/srv/blackframe-data
BLACKFRAME_ENV_FILE=/srv/blackframe-data/config/app.env
LOCAL_BACKUP_RETENTION_DAYS=7
OCI_BUCKET=blackframe-backups
# Leave empty to let the OCI CLI discover the tenancy namespace.
OCI_NAMESPACE=
OCI_BACKUP_PREFIX=blackframe
